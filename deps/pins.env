# Pinned sibling checkouts for the litecoin fork's CI.
#
# This crate cannot be built from a checkout of itself. Every dependency is a
# relative path out of the repo — ../crates/* into bdk, and ../../rust-litecoin
# for the [patch.crates-io] litecoin entry — so CI has to reassemble the tree:
#
#   <root>/bdk/                    IndigoNakamoto/bdk @ BDK_REF
#   <root>/bdk/bdk_wallet/         this repo
#   <root>/rust-litecoin/          IndigoNakamoto/rust-litecoin @ RUST_LITECOIN_REF
#
# The inherited upstream workflows check out only this repo, which is why they
# have never run on the litecoin branch. See .github/workflows/litecoin_ci.yml.
#
# Keep these in step with ltc-wallet-mac's deps/pins.env: that repo pins this
# one, so a combination that only works here is not actually shipped.
BDK_REPO=IndigoNakamoto/bdk
BDK_REF=d8e220c20da06bbda212f21ced7544aad54ab1a7
RUST_LITECOIN_REPO=IndigoNakamoto/rust-litecoin
RUST_LITECOIN_REF=0b3285337f3cc508a5549d245ce20d3b52418f3a
